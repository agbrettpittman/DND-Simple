// Prisma schema for DND-Simple backend
// Uses SQLite and maps to existing users table/columns

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaigns Campaign[]
}

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
 
