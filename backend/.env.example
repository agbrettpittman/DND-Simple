# Backend environment example
# Copy this file to .env and adjust values as needed.

# Server network config
SERVER_IP=127.0.0.1
SERVER_PORT=8000

# Bcrypt cost factor for hashing passwords
SALT_ROUNDS=10

# Prisma SQLite database URL
# Path is relative to backend/prisma/schema.prisma
# Example stores DB at backend/data/db/db.sqlite
DATABASE_URL="file:../data/db/db.sqlite"
